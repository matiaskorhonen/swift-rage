[Error]
enum RageError {
  "Io",
  "WrongPassphrase",
  "NoMatchingIdentity",
  "EncryptedWithPassphrase",
  "EncryptedToRecipients",
  "InvalidKey",
  "MalformedInput",
  "ExcessiveWorkFactor",
  "InvalidRecipient",
  "EncryptionFailed",
  "SshPassphraseRequired",
  "SshWrongPassphrase",
  "SshUnsupportedAlgorithm",
  "SshKeyTooLarge",
};

dictionary Identity {
  string key_data;
};

dictionary Recipient {
  string key_data;
};

dictionary IdentityInfo {
  string recipient;
  string key_type;
};

dictionary SshIdentity {
  string private_key;
  string public_key;
  string fingerprint;
  string algorithm;
};

dictionary FileMetadata {
  boolean is_armored;
  sequence<string> stanza_types;
  u8? scrypt_work_factor;
};

namespace swift_rage {
  [Throws=RageError]
  Identity generate_identity();

  [Throws=RageError]
  Identity parse_identity(string identity_str);

  [Throws=RageError]
  Recipient identity_to_recipient(Identity identity);

  [Throws=RageError]
  IdentityInfo identity_info(Identity identity);

  [Throws=RageError]
  SshIdentity parse_ssh_identity(string private_key, string? passphrase);

  [Throws=RageError]
  Recipient parse_recipient(string recipient_str);

  [Throws=RageError]
  FileMetadata parse_file_metadata(string file_path);

  [Throws=RageError]
  void encrypt_file(string input_path, string output_path, sequence<Recipient> recipients, boolean armor);

  [Throws=RageError]
  void encrypt_file_with_passphrase(string input_path, string output_path, string passphrase, boolean armor);

  [Throws=RageError]
  string decrypt_file(string input_path, sequence<Identity> identities, string? output_directory);

  [Throws=RageError]
  string decrypt_file_with_passphrase(string input_path, string passphrase, u8? max_work_factor, string? output_directory);
};
